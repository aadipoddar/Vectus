<div class="launchpad-section">
	<h2 class="launchpad-section-title">Key Figures</h2>
	<div class="dashboard-grid">

		<FioriTile Title="Pending Trip Requests" Subtitle="awaiting approval" KPI="@_pendingTripRequestsCount.ToString()" OnClick="() => NavigationManager.NavigateTo(PageRouteNames.TripRequest)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M9 2h6a1 1 0 0 1 1 1v2H8V3a1 1 0 0 1 1-1z" />
					<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
					<path d="M9 13l2 2 4-4" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Trips This Month" Subtitle="@_thisMonthTripsTrend" KPI="@_thisMonthTripsCount.ToString()" OnClick="() => NavigationManager.NavigateTo(PageRouteNames.TripRequestReport)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="1" y="3" width="15" height="13" />
					<polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
					<circle cx="5.5" cy="18.5" r="2.5" />
					<circle cx="18.5" cy="18.5" r="2.5" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Repair Spend This Month" Subtitle="@_thisMonthRepairSpendTrend" KPI="@_thisMonthRepairSpend" OnClick="() => NavigationManager.NavigateTo(PageRouteNames.RepairReport)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Vehicles in Garage" Subtitle="@_inGarageVehiclesNote" KPI="@_inGarageVehiclesCount.ToString()" OnClick="() => NavigationManager.NavigateTo(PageRouteNames.Repair)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 10.5 12 3l9 7.5" />
					<path d="M5 9.5V21h14V9.5" />
					<path d="M8 21v-6h8v6" />
					<path d="M10 12h4" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Documents Due Soon" Subtitle="@_dueDocumentsNote" KPI="@_dueDocumentsCount.ToString()" OnClick="() => NavigationManager.NavigateTo(PageRouteNames.VehicleDocumentRenewalReport)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
					<line x1="16" y1="2" x2="16" y2="6" />
					<line x1="8" y1="2" x2="8" y2="6" />
					<line x1="3" y1="10" x2="21" y2="10" />
					<path d="M8 14l3 3 5-5" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Active Vehicles" Subtitle="@_activeVehiclesNote" KPI="@_activeVehiclesCount.ToString()" OnClick="() => NavigationManager.NavigateTo(PageRouteNames.VehicleMaster)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M10 17h4V5H2v12h3" />
					<path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h1" />
					<circle cx="7.5" cy="17.5" r="2.5" />
					<circle cx="17.5" cy="17.5" r="2.5" />
				</svg>
			</IconContent>
		</FioriTile>

	</div>
</div>
