@using VectusLibrary.Payroll.Masters.Models

@attribute [Route(PageRouteNames.EmployeeMaster)]

<PageTitle>Employee Management - Vectus</PageTitle>

<MudBlazor.MudHotkey Key=JsKey.KeyN KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ResetPage" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyF KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => _firstFocus.FocusAsync()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyS KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="SaveTransaction" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyE KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportMaster(true)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyP KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportMaster()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.Delete KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleDeleted" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.Insert OnHotkeyPressed="EditSelectedItem" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.Delete OnHotkeyPressed="DeleteRecoverSelectedItem" Disabled="@_isProcessing" />

@if (_isLoading || _user is null)
{
	<LoadingScreen />
}
else
{
	<div class="page-shell">
		<Header Title="Employee Management">
			<LeftContent>
				<MudBlazor.MudMenu Label="File" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="New (Ctrl + N)" OnClick="ResetPage" />
					<MudBlazor.MudMenuItem Label="Save (Ctrl + S)" OnClick="SaveTransaction" />
					<MudBlazor.MudMenuItem Label="@(_showDeleted ? "Hide Deleted (Ctrl + Delete)" : "Show Deleted (Ctrl + Delete)")" OnClick="ToggleDeleted" />
					<MudBlazor.MudDivider />
					<MudBlazor.MudMenuItem Label="Export Excel (Ctrl + E)" OnClick="() => ExportMaster(true)" />
					<MudBlazor.MudMenuItem Label="Export PDF (Ctrl + P)" OnClick="() => ExportMaster()" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Transaction" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Edit (Insert)" OnClick="EditSelectedItem" />
					<MudBlazor.MudMenuItem Label="Delete / Recover (Del)" OnClick="DeleteRecoverSelectedItem" />
				</MudBlazor.MudMenu>
			</LeftContent>
		</Header>

		<div class="page-container">
			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
							 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
							 stroke-linejoin="round">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
							<circle cx="12" cy="7" r="4" />
						</svg>
						<h2 class="section-title">Employee Details</h2>
					</div>
				</div>
				<div class="section-body">
					<div class="form-grid">
						<div class="form-field">
							<CustomTextField @ref="_firstFocus"
											 @bind-Value="_employee.Name"
											 Label="Name (Ctrl + F)"
											 Placeholder="Enter Employee Name" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.Code"
											 Label="Code"
											 Placeholder="Auto-generated"
											 ReadOnly="true"
											 TabIndex="-1" />
						</div>

						<div class="form-field">
							<CustomAutoComplete T="DepartmentModel"
												@bind-Value="_selectedDepartment"
												DataSource="@_departments"
												Placeholder="Select Department"
												Label="Department"
												FieldValue="@nameof(DepartmentModel.Name)"
												AddNewRoute="@PageRouteNames.DepartmentMaster" />
						</div>

						<div class="form-field">
							<CustomAutoComplete T="DesignationModel"
												@bind-Value="_selectedDesignation"
												DataSource="@_designations"
												Placeholder="Select Designation"
												Label="Designation"
												FieldValue="@nameof(DesignationModel.Name)"
												AddNewRoute="@PageRouteNames.DesignationMaster" />
						</div>

						<div class="form-field">
							<CustomAutoComplete T="EmployeeLocationModel"
												@bind-Value="_selectedLocation"
												DataSource="@_locations"
												Placeholder="Select Location"
												Label="Location"
												FieldValue="@nameof(EmployeeLocationModel.Name)"
												AddNewRoute="@PageRouteNames.EmployeeLocationMaster" />
						</div>

						<div class="form-field">
							<CustomDatePicker @bind-Value="_employee.DateOfJoining"
											  Label="Date of Joining"
											  ShowFinancialYear="false"
											  AddNewRoute="@(null)" />
						</div>

						<div class="form-field">
							<CustomDatePicker @bind-NullableValue="_employee.DateOfLeaving"
											  Label="Date of Leaving"
											  Required="false"
											  ShowFinancialYear="false"
											  AddNewRoute="@(null)" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.Phone"
											 Label="Phone"
											 Placeholder="Enter Phone"
											 Required="false"
											 MaxLength="10" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.PersonalEmail"
											 Label="Personal Email"
											 Placeholder="Enter Personal Email"
											 Required="false" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.WorkEmail"
											 Label="Work Email"
											 Placeholder="Enter Work Email"
											 Required="false" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.Address"
											 Label="Address"
											 Placeholder="Enter Address"
											 Required="false"
											 Lines="2" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.Remarks"
											 Label="Remarks"
											 Placeholder="Enter Remarks"
											 Required="false"
											 Lines="2" />
						</div>
					</div>
				</div>
			</div>

			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
							 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
							 stroke-linejoin="round">
							<rect x="2" y="5" width="20" height="14" rx="2" />
							<line x1="2" y1="10" x2="22" y2="10" />
						</svg>
						<h2 class="section-title">Payment Details</h2>
					</div>
				</div>
				<div class="section-body">
					<div class="form-grid">
						<div class="form-field">
							<CustomAutoComplete T="string"
												@bind-Value="_employee.PaymentMode"
												DataSource="@_paymentModes"
												Placeholder="Select Payment Mode"
												Label="Payment Mode" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.BankName"
											 Label="Bank Name"
											 Placeholder="Enter Bank Name"
											 Required="false" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.BankAccountNo"
											 Label="Bank Account No"
											 Placeholder="Enter Bank Account No"
											 Required="false" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.IFSC"
											 Label="IFSC"
											 Placeholder="Enter IFSC (e.g. SBIN0001234)"
											 Required="false"
											 MaxLength="11" />
						</div>
					</div>
				</div>
			</div>

			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
							 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
							 stroke-linejoin="round">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
						</svg>
						<h2 class="section-title">Statutory Details</h2>
					</div>
				</div>
				<div class="section-body">
					<div class="form-grid">
						<div class="form-field">
							<CustomTextField @bind-Value="_employee.PANNo"
											 Label="PAN No"
											 Placeholder="Enter PAN (e.g. ABCDE1234F)"
											 Required="false"
											 MaxLength="10" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.AadhaarNo"
											 Label="Aadhaar No"
											 Placeholder="Enter 12-digit Aadhaar"
											 Required="false"
											 MaxLength="12" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.PFUAN"
											 Label="PF UAN"
											 Placeholder="Enter PF UAN"
											 Required="false"
											 MaxLength="12" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.PFNumber"
											 Label="PF Number"
											 Placeholder="Enter PF Number"
											 Required="false" />
						</div>

						<div class="form-field">
							<CustomTextField @bind-Value="_employee.ESINumber"
											 Label="ESI Number"
											 Placeholder="Enter ESI Number"
											 Required="false"
											 MaxLength="17" />
						</div>

						<div class="form-field">
							<CustomDatePicker @bind-NullableValue="_employee.ESICoveredUpto"
											  Label="ESI Covered Upto"
											  Required="false"
											  ShowFinancialYear="false"
											  AddNewRoute="@(null)" />
						</div>

						<div class="form-field">
							<div class="checkbox-wrapper">
								<CustomCheckBox @bind-Value="_employee.IsPFApplicable"
												Label="PF Applicable"
												AriaLabel="Mark whether PF applies to this employee" />
							</div>
						</div>

						<div class="form-field">
							<div class="checkbox-wrapper">
								<CustomCheckBox @bind-Value="_employee.IsESIApplicable"
												Label="ESI Applicable"
												AriaLabel="Mark whether ESI applies to this employee" />
							</div>
						</div>

						<div class="form-field">
							<div class="checkbox-wrapper">
								<CustomCheckBox @bind-Value="_employee.IsPTApplicable"
												Label="PT Applicable"
												AriaLabel="Mark whether Professional Tax applies to this employee" />
							</div>
						</div>

						<div class="form-field">
							<div class="checkbox-wrapper">
								<CustomCheckBox @bind-Value="_employee.IsLWFApplicable"
												Label="LWF Applicable"
												AriaLabel="Mark whether Labour Welfare Fund applies to this employee" />
							</div>
						</div>

						<div class="form-field">
							<div class="checkbox-wrapper">
								<CustomCheckBox @bind-Value="_employee.ContributeOnHigherPFWage"
												Label="Contribute on Higher PF Wage"
												AriaLabel="Mark whether PF is contributed on actual wage above the ceiling" />
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
							 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
							 stroke-linejoin="round">
							<path d="M9 11l3 3L22 4" />
							<path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
						</svg>
						<h2 class="section-title">Employees List</h2>
					</div>
				</div>
				<div class="section-body grid-body">
					<SfGrid @ref="_sfGrid" DataSource="@_employees" AllowPaging="true" AllowSorting="true"
							AllowFiltering="true" AllowResizing="true" CssClass="professional-grid"
							Toolbar="@(new List<string>() { "Search" })" ContextMenuItems="@_gridContextMenuItems">
						<GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
						<GridEvents TValue="EmployeeModel" ContextMenuItemClicked="OnGridContextMenuItemClicked" />
						<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
						<GridColumns>
							<GridColumn Field="@nameof(EmployeeModel.Id)" HeaderText="ID" Width="80" TextAlign="TextAlign.Center" />
							<GridColumn Field="@nameof(EmployeeModel.Code)" HeaderText="Code" Width="120" />
							<GridColumn Field="@nameof(EmployeeModel.Name)" HeaderText="Employee Name" Width="220" />
							<GridColumn Field="@nameof(EmployeeModel.DepartmentId)" HeaderText="Department" Width="160">
								<Template>
									@{
										var item = (context as EmployeeModel);
										<span>@(_departments.FirstOrDefault(d => d.Id == item.DepartmentId)?.Name ?? "N/A")</span>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="@nameof(EmployeeModel.DesignationId)" HeaderText="Designation" Width="160">
								<Template>
									@{
										var item = (context as EmployeeModel);
										<span>@(_designations.FirstOrDefault(d => d.Id == item.DesignationId)?.Name ?? "N/A")</span>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="@nameof(EmployeeModel.EmployeeLocationId)" HeaderText="Location" Width="160">
								<Template>
									@{
										var item = (context as EmployeeModel);
										<span>@(_locations.FirstOrDefault(l => l.Id == item.EmployeeLocationId)?.Name ?? "N/A")</span>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="@nameof(EmployeeModel.DateOfJoining)" HeaderText="Date of Joining" Width="140" Format="dd-MM-yyyy" Type="ColumnType.Date" TextAlign="TextAlign.Center" />
							<GridColumn Field="@nameof(EmployeeModel.DateOfLeaving)" HeaderText="Date of Leaving" Width="140" Format="dd-MM-yyyy" Type="ColumnType.Date" TextAlign="TextAlign.Center" />
							<GridColumn Field="@nameof(EmployeeModel.PaymentMode)" HeaderText="Payment Mode" Width="130" TextAlign="TextAlign.Center" />
							<GridColumn Field="@nameof(EmployeeModel.BankName)" HeaderText="Bank Name" Width="160" />
							<GridColumn Field="@nameof(EmployeeModel.BankAccountNo)" HeaderText="Bank Account No" Width="160" />
							<GridColumn Field="@nameof(EmployeeModel.IFSC)" HeaderText="IFSC" Width="130" />
							<GridColumn Field="@nameof(EmployeeModel.PANNo)" HeaderText="PAN No" Width="130" />
							<GridColumn HeaderText="Aadhaar" Width="150">
								<Template>
									@{
										var item = (context as EmployeeModel);
										<span>@(MaskAadhaar(item.AadhaarNo))</span>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="@nameof(EmployeeModel.PFUAN)" HeaderText="PF UAN" Width="150" />
							<GridColumn Field="@nameof(EmployeeModel.PFNumber)" HeaderText="PF Number" Width="150" />
							<GridColumn Field="@nameof(EmployeeModel.ESINumber)" HeaderText="ESI Number" Width="150" />
							<GridColumn Field="@nameof(EmployeeModel.ESICoveredUpto)" HeaderText="ESI Covered Upto" Width="150" Format="dd-MM-yyyy" Type="ColumnType.Date" TextAlign="TextAlign.Center" />
							<GridColumn Field="@nameof(EmployeeModel.IsPFApplicable)" HeaderText="PF Applicable" Width="130" TextAlign="TextAlign.Center">
								<Template>
									@{
										var item = (context as EmployeeModel);
										<span class="@(item.IsPFApplicable ? "grid-credit" : "grid-debit")">@(item.IsPFApplicable ? "Yes" : "No")</span>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="@nameof(EmployeeModel.IsESIApplicable)" HeaderText="ESI Applicable" Width="130" TextAlign="TextAlign.Center">
								<Template>
									@{
										var item = (context as EmployeeModel);
										<span class="@(item.IsESIApplicable ? "grid-credit" : "grid-debit")">@(item.IsESIApplicable ? "Yes" : "No")</span>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="@nameof(EmployeeModel.IsPTApplicable)" HeaderText="PT Applicable" Width="130" TextAlign="TextAlign.Center">
								<Template>
									@{
										var item = (context as EmployeeModel);
										<span class="@(item.IsPTApplicable ? "grid-credit" : "grid-debit")">@(item.IsPTApplicable ? "Yes" : "No")</span>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="@nameof(EmployeeModel.IsLWFApplicable)" HeaderText="LWF Applicable" Width="130" TextAlign="TextAlign.Center">
								<Template>
									@{
										var item = (context as EmployeeModel);
										<span class="@(item.IsLWFApplicable ? "grid-credit" : "grid-debit")">@(item.IsLWFApplicable ? "Yes" : "No")</span>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="@nameof(EmployeeModel.ContributeOnHigherPFWage)" HeaderText="Higher PF Wage" Width="140" TextAlign="TextAlign.Center">
								<Template>
									@{
										var item = (context as EmployeeModel);
										<span class="@(item.ContributeOnHigherPFWage ? "grid-credit" : "grid-debit")">@(item.ContributeOnHigherPFWage ? "Yes" : "No")</span>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="@nameof(EmployeeModel.Phone)" HeaderText="Phone" Width="140" />
							<GridColumn Field="@nameof(EmployeeModel.PersonalEmail)" HeaderText="Personal Email" Width="200" />
							<GridColumn Field="@nameof(EmployeeModel.WorkEmail)" HeaderText="Work Email" Width="200" />
							<GridColumn Field="@nameof(EmployeeModel.Address)" HeaderText="Address" Width="220" />
							<GridColumn Field="@nameof(EmployeeModel.Remarks)" HeaderText="Remarks" Width="220" />
							<GridColumn Field="@nameof(EmployeeModel.Status)" HeaderText="Status" Width="110" TextAlign="TextAlign.Center" Visible="_showDeleted">
								<Template>
									@{
										var item = (context as EmployeeModel);
										<span class="@(item.Status ? string.Empty : "grid-debit")">@(item.Status ? "Active" : "Deleted")</span>
									}
								</Template>
							</GridColumn>
						</GridColumns>
					</SfGrid>
				</div>
			</div>
		</div>

		<Footer />
	</div>
}

<ConfirmationDialog @ref="_confirmationDialog" Title="@_confirmTitle" Message="@_confirmMessage"
					OnConfirm="OnConfirmed" OnCancel="OnCancelled" />

<ToastNotification @ref="_toastNotification" />

<CloseGuard Block="_isProcessing" />
