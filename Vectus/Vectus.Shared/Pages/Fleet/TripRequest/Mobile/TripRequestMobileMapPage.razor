@attribute [Route(PageRouteNames.TripRequestMobileMap + "/{RouteId:int}")]

@using VectusLibrary.Common
@using VectusLibrary.Fleet.Vehicle.Models
@using Vectus.Shared.Components.Map

<PageTitle>Trip Request - Vectus Mobile</PageTitle>

<HeadContent>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
</HeadContent>

@if (_isLoading || _user is null || _route is null)
{
	<LoadingScreen />
}
else
{
	<div class="trip-app">
		<div class="map-wrap">
			<div class="map-canvas">
				<RouteMap OriginLatitude="_route.FromLocationLatitude"
						  OriginLongitude="_route.FromLocationLongitude"
						  DestinationLatitude="_route.ToLocationLatitude"
						  DestinationLongitude="_route.ToLocationLongitude"
						  Vehicles="_vehicles"
						  SelectedVehicleCode="@_mapHighlightCode"
						  OnVehicleSelected="OnMapVehicleSelected"
						  Mobile="true"
						  PlaceholderText="This route has no map coordinates set on its locations." />
			</div>

			@* top bar — back + route summary *@
			<div class="map-top">
				<button class="iconbtn solid" @onclick="() => NavigationManager.NavigateTo(PageRouteNames.TripRequestMobile)">@IconBack</button>
				<div class="route-chip">
					<span class="place">@_route.FromLocationName</span>
					<span class="arrow">→</span>
					<span class="place">@_route.ToLocationName</span>
				</div>
			</div>

			@* bottom sheet — choose a vehicle *@
			<div class="map-sheet" @ref="_sheetRef">
				<div class="handle-wrap" @ref="_handleRef"><div class="handle"></div></div>
				<div class="sheet-h">Choose a vehicle</div>
				<div class="sheet-divider"></div>

				@if (_selectedVehicle is null)
				{
					<div class="sheet-empty">No vehicles available near this route's origin right now.</div>
				}
				else
				{
					var sStatus = Status(_selectedVehicle);
					<div class="hero-vehicle" @onclick="ToggleSelectedCard">
						<div class="top">
							<div class="veh-img">@VehicleHero(92, sStatus)</div>
							<div class="head">
								<div class="code"><span class="mono">@_selectedVehicle.Code</span></div>
								<div class="meta">
									@if (!string.IsNullOrWhiteSpace(_selectedVehicle.SDR))
									{
										<span class="sdr">@_selectedVehicle.SDR</span><span> · </span>
									}
									<span>@MinAway(_selectedVehicle.HaversineDistance) min away</span>
								</div>
								<div class="badges">
									@if (_vehicles.FirstOrDefault()?.Id == _selectedVehicle.Id)
									{
										<span class="vehicle-badge nearest">@IconBolt Nearest</span>
									}
								</div>
							</div>
							<div class="price-col">
								<div class="price">@_selectedVehicle.HaversineDistance.FormatDistanceKm()</div>
							</div>
						</div>
					</div>

					<div class="veh-search">
						@IconSearch
						<input placeholder="Search vehicle or SDR" value="@_vehicleQuery"
							   @oninput="e => _vehicleQuery = e.Value?.ToString()" />
						@if (!string.IsNullOrEmpty(_vehicleQuery))
						{
							<button class="clear" @onclick="() => _vehicleQuery = string.Empty">@IconClose</button>
						}
					</div>

					<div class="truck-list">
						@{
							var others = FilteredOtherVehicles;
						}
						@if (others.Count == 0)
						{
							<div class="list-empty">No vehicles match "@_vehicleQuery"</div>
						}
						@foreach (var v in others)
						{
							var vStatus = Status(v);
							<div class="truck-row" @onclick="() => SelectVehicle(v)">
								<div class="veh-img">@VehicleHero(62, vStatus)</div>
								<div class="grow">
									<div class="code">
										<span class="mono">@v.Code</span>
										<span class="status-dot" style="background:@StatusColor(vStatus)"></span>
									</div>
									<div class="meta">
										@if (!string.IsNullOrWhiteSpace(v.SDR))
										{
											<span class="sdr">@v.SDR</span>
											<span class="sep"></span>
										}
										<span>@MinAway(v.HaversineDistance) min away</span>
									</div>
								</div>
								<div class="right">
									<div class="price">@v.HaversineDistance.FormatDistanceKm()</div>
								</div>
							</div>
						}
					</div>
				}

				<div class="sheet-cta">
					<button class="btn" disabled="@(_selectedVehicle is null || _isProcessing)" @onclick="OpenConfirm">
						@if (_selectedVehicle is not null)
						{
							<span>Choose</span>
							<span class="mono" style="font-size:14px;margin-left:4px">@_selectedVehicle.Code</span>
						}
						else
						{
							<span>Select a vehicle</span>
						}
					</button>
				</div>
			</div>
		</div>

		@* confirm sheet — review before dispatch *@
		@if (_selectedVehicle is not null)
		{
			var cStatus = Status(_selectedVehicle);
			<div class="sheet-backdrop @(_confirmOpen ? "open" : "")" style="z-index:39" @onclick="() => _confirmOpen = false"></div>
			<div class="confirm-sheet @(_confirmOpen ? "open" : "")">
				<div class="handle-wrap"></div>
				<h2>Confirm your trip</h2>
				<p class="lead">Review the details before dispatch is notified.</p>

				<div class="confirm-body">
					@* route card *@
					<div class="review-card">
						<div class="review-title">Route <span class="rt-code">@_route.Code</span></div>
						<div class="confirm-route">
							<div class="timeline">
								<div class="dot start"></div>
								<div class="stem"></div>
								<div class="dot end"></div>
							</div>
							<div class="pts">
								<div><div class="place">@_route.FromLocationName</div><div class="city">Origin</div></div>
								<div><div class="place">@_route.ToLocationName</div><div class="city">Destination</div></div>
							</div>
						</div>
					</div>

					@* vehicle card *@
					<div class="review-card">
						<div class="review-title">Vehicle</div>
						<div class="veh-row">
							<div class="veh-img">@VehicleHero(64, cStatus)</div>
							<div class="v-head">
								<div class="v-code"><span class="mono">@_selectedVehicle.Code</span></div>
								<div class="v-meta">
									@if (!string.IsNullOrWhiteSpace(_selectedVehicle.SDR))
									{
										<span class="sdr">@_selectedVehicle.SDR</span><span> · </span>
									}
									<span>@cStatus</span>
								</div>
							</div>
							<div class="v-dist">
								<div class="d">@_selectedVehicle.HaversineDistance.FormatDistanceKm()</div>
								<div class="u">away</div>
							</div>
						</div>
					</div>

					@* summary card *@
					<div class="review-card">
						<div class="review-title">Summary</div>
						<div class="review-line"><span class="k">Company</span><span class="v">@_company?.Name</span></div>
						<div class="review-line"><span class="k">Distance</span><span class="v">@_route.EstimatedDistance km</span></div>
						<div class="review-line"><span class="k">Est. duration</span><span class="v">@_route.EstimatedHours.FormatHours()</span></div>
						<div class="review-line"><span class="k">Est. fuel</span><span class="v">@_route.EstimatedFuelConsumption L</span></div>
						<div class="review-line"><span class="k">Est. cost</span><span class="v">@_route.EstimatedCost.FormatIndianCurrencyShort()</span></div>
					</div>
				</div>

				<div class="confirm-cta">
					<button class="btn" disabled="@_isProcessing" @onclick="ConfirmTransaction">Confirm trip request</button>
					<button class="btn ghost" @onclick="() => _confirmOpen = false">Cancel</button>
				</div>
			</div>
		}

		@* success overlay *@
		<div class="success-overlay @(_success ? "on" : "")">
			<div class="success-card">
				<div class="check">@IconCheck</div>
				<h3>Trip request confirmed</h3>
				<p>Dispatch has been notified. @_selectedVehicle?.SDR will accept or reject shortly.</p>
				@if (!string.IsNullOrWhiteSpace(_txnNo))
				{
					<div class="txnno">@_txnNo</div>
				}
				<button class="btn" @onclick="() => NavigationManager.NavigateTo(PageRouteNames.TripRequestMobile)">Done</button>
			</div>
		</div>
	</div>
}

<ToastNotification @ref="_toastNotification" />

@* ───────────────────────── Icons + vehicle illustration ───────────────────────── *@
@code {
	private RenderFragment IconBack => @<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>;
	private RenderFragment IconSearch => @<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="M21 21l-4.35-4.35" /></svg>;
	private RenderFragment IconClose => @<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12" /></svg>;
	private RenderFragment IconBolt => @<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" /></svg>;
	private RenderFragment IconCheck => @<svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>;

	// Side-profile cargo truck. `status` overlays a small coloured dot
	// (Moving pulses) using the same vocabulary as the map markers.
	private RenderFragment VehicleHero(int size, string status) => @<svg viewBox="0 0 120 80" width="@size" height="@(size * 0.66)" style="display:block;overflow:visible">
		<ellipse cx="60" cy="74" rx="46" ry="3" fill="rgba(0,0,0,0.14)" />
		<rect x="44" y="18" width="68" height="40" rx="3" fill="#fff" stroke="#0b0b0c" stroke-width="2.2" />
		<line x1="44" y1="32" x2="112" y2="32" stroke="#0b0b0c" stroke-width="1" opacity="0.25" />
		<line x1="44" y1="44" x2="112" y2="44" stroke="#0b0b0c" stroke-width="1" opacity="0.25" />
		<line x1="60" y1="18" x2="60" y2="58" stroke="#0b0b0c" stroke-width="1" opacity="0.25" />
		<line x1="78" y1="18" x2="78" y2="58" stroke="#0b0b0c" stroke-width="1" opacity="0.25" />
		<line x1="96" y1="18" x2="96" y2="58" stroke="#0b0b0c" stroke-width="1" opacity="0.25" />
		<path d="M 8,58 L 8,38 L 14,30 L 28,30 L 32,18 L 44,18 L 44,58 Z" fill="#fff" stroke="#0b0b0c" stroke-width="2.2" stroke-linejoin="round" />
		<path d="M 16,32 L 28,32 L 31,22 L 19,22 Z" fill="#1a1a1a" />
		<line x1="32" y1="32" x2="32" y2="50" stroke="#0b0b0c" stroke-width="1.2" opacity="0.4" />
		<rect x="36" y="40" width="4" height="1.5" fill="#0b0b0c" opacity="0.5" />
		<rect x="8" y="42" width="3" height="4" rx="0.5" fill="#ffd166" />
		<rect x="6" y="54" width="6" height="4" rx="1" fill="#0b0b0c" />
		<g>
			<circle cx="22" cy="60" r="7" fill="#0b0b0c" /><circle cx="22" cy="60" r="3" fill="#fff" />
			<circle cx="80" cy="60" r="7" fill="#0b0b0c" /><circle cx="80" cy="60" r="3" fill="#fff" />
			<circle cx="96" cy="60" r="7" fill="#0b0b0c" /><circle cx="96" cy="60" r="3" fill="#fff" />
		</g>
		@if (!string.IsNullOrEmpty(status))
		{
			<circle cx="106" cy="22" r="5" fill="@StatusColor(status)" stroke="#fff" stroke-width="2" />
			@if (status == "Moving")
			{
				<circle cx="106" cy="22" r="5" fill="none" stroke="@StatusColor(status)" stroke-width="1.5" opacity="0.5">
					<animate attributeName="r" values="5;10;5" dur="1.6s" repeatCount="indefinite" />
					<animate attributeName="opacity" values="0.6;0;0.6" dur="1.6s" repeatCount="indefinite" />
				</circle>
			}
		}
	</svg>;
}
