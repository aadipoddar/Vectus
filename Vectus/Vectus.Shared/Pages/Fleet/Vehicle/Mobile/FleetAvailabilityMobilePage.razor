@attribute [Route(PageRouteNames.FleetAvailabilityMobile)]

<PageTitle>Fleet Availability — Vectus Mobile</PageTitle>

<HeadContent>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
</HeadContent>

@if (_isLoading || _user is null)
{
	<LoadingScreen />
}
else
{
	<div class="fleet-app">
		<div class="f-stage">
			<div class="f-topbar">
				<button class="f-iconbtn" style="visibility:hidden">@IconBack</button>
				<div style="flex:1"></div>
				<button class="f-iconbtn" title="Home" @onclick='() => NavigationManager.NavigateTo(PageRouteNames.Dashboard)'>@IconHome</button>
			</div>

			<div class="f-head">
				<h1 class="display f-h1">Fleet availability</h1>
				<div class="f-sub">Tap to flip a truck on or off — saves instantly.</div>
			</div>

			<div class="f-summary">
				<div class="row1">
					<div class="big">
						<span class="n">@AvailableCount</span>
						<span class="of">/ @Total trucks available</span>
					</div>
					<button class="f-allbtn" disabled="@(_isProcessing || Total == 0)" @onclick="SetAll">
						@(AllOn ? "Set all off" : "Set all available")
					</button>
				</div>
				<div class="track"><div class="fill" style="width:@(Percent)%"></div></div>
				<div class="legend">
					<div class="li"><span class="sw" style="background:var(--promo)"></span> @AvailableCount available</div>
					<div class="li"><span class="sw" style="background:var(--ink-3)"></span> @(Total - AvailableCount) off duty</div>
				</div>
			</div>

			@if (_fleet.Count > 0)
			{
				<div class="f-search">
					@IconSearch
					<input placeholder="Search truck or location" value="@_query"
						   @oninput="e => _query = e.Value?.ToString()" />
					@if (!string.IsNullOrEmpty(_query))
					{
						<button class="f-clear" @onclick="() => _query = string.Empty">@IconClose</button>
					}
				</div>
			}

			<div class="f-list">
				@if (_fleet.Count == 0)
				{
					<div class="f-empty">
						<h3>No trucks assigned</h3>
						<p>You don't have any vehicles linked to your SDR yet. Once assigned, they'll appear here to manage.</p>
					</div>
				}
				else if (FilteredFleet.Count == 0)
				{
					<div class="f-empty">
						<h3>No matches</h3>
						<p>No trucks match "@_query". Try a different code or location.</p>
					</div>
				}
				else
				{
					@foreach (var v in FilteredFleet)
					{
						var on = v.AvailableStatus;
						var status = Status(v);
						<div class="v-row @(on ? "on" : "off")">
							<div class="veh-img">@Truck(58, on ? status : null, !on)</div>
							<div class="grow">
								<div class="vcode">
									<span class="mono">@v.Code</span>
									@if (on)
									{
										<span class="sdot" style="background:@StatusColor(status)"></span>
									}
								</div>
								<div class="vmeta">
									<span class="loc">@IconPin @(string.IsNullOrWhiteSpace(v.Address) ? "Location unavailable" : v.Address)</span>
								</div>
								<div class="state">@(on ? $"Available · {status}" : "Off duty")</div>
							</div>
							<button class="toggle @(on ? "on" : "")" disabled="@_isProcessing" @onclick="() => ToggleOne(v)" aria-pressed="@(on ? "true" : "false")">
								<span class="knob"></span>
							</button>
						</div>
					}
				}
			</div>
		</div>

		<div class="f-toast @(_toastOn ? "on" : "")">
			<span class="tdot" style="background:@(_toastOk ? "var(--promo)" : "var(--ink-3)")"></span>
			<span>
				@if (!string.IsNullOrEmpty(_toastCode))
				{
					<span class="mono">@_toastCode</span>
					<text> </text>
				}
				@_toastText
			</span>
		</div>
	</div>
}

@* ───────────────────────── Icons (thin, geometric) ───────────────────────── *@
@code {
	private RenderFragment IconBack => @<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>;
	private RenderFragment IconHome => @<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5L12 3l9 7.5V21a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1V10.5z" /></svg>;
	private RenderFragment IconPin => @<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 7-8 12-8 12s-8-5-8-12a8 8 0 1 1 16 0z" /><circle cx="12" cy="10" r="3" /></svg>;
	private RenderFragment IconSearch => @<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="M21 21l-4.35-4.35" /></svg>;
	private RenderFragment IconClose => @<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12" /></svg>;

	// Side-profile cargo truck illustration (cab + box + wheels). Dims when off-duty;
	// a status dot appears top-right when the truck is available and has live data.
	private RenderFragment Truck(int size, string status, bool off) => @<svg viewBox="0 0 120 80" width="@size" height="@(size * 0.66)" style="display:block;overflow:visible;opacity:@(off ? "0.4" : "1");transition:opacity .2s ease">
		<ellipse cx="60" cy="74" rx="46" ry="3" fill="rgba(0,0,0,0.14)" />
		<rect x="44" y="18" width="68" height="40" rx="3" fill="#fff" stroke="#0b0b0c" stroke-width="2.2" />
		<line x1="44" y1="32" x2="112" y2="32" stroke="#0b0b0c" stroke-width="1" opacity="0.25" />
		<line x1="44" y1="44" x2="112" y2="44" stroke="#0b0b0c" stroke-width="1" opacity="0.25" />
		<line x1="60" y1="18" x2="60" y2="58" stroke="#0b0b0c" stroke-width="1" opacity="0.25" />
		<line x1="78" y1="18" x2="78" y2="58" stroke="#0b0b0c" stroke-width="1" opacity="0.25" />
		<line x1="96" y1="18" x2="96" y2="58" stroke="#0b0b0c" stroke-width="1" opacity="0.25" />
		<path d="M 8,58 L 8,38 L 14,30 L 28,30 L 32,18 L 44,18 L 44,58 Z" fill="#fff" stroke="#0b0b0c" stroke-width="2.2" stroke-linejoin="round" />
		<path d="M 16,32 L 28,32 L 31,22 L 19,22 Z" fill="#1a1a1a" />
		<line x1="32" y1="32" x2="32" y2="50" stroke="#0b0b0c" stroke-width="1.2" opacity="0.4" />
		<rect x="36" y="40" width="4" height="1.5" fill="#0b0b0c" opacity="0.5" />
		<rect x="8" y="42" width="3" height="4" rx="0.5" fill="#ffd166" />
		<rect x="6" y="54" width="6" height="4" rx="1" fill="#0b0b0c" />
		<g>
			<circle cx="22" cy="60" r="7" fill="#0b0b0c" /><circle cx="22" cy="60" r="3" fill="#fff" />
			<circle cx="80" cy="60" r="7" fill="#0b0b0c" /><circle cx="80" cy="60" r="3" fill="#fff" />
			<circle cx="96" cy="60" r="7" fill="#0b0b0c" /><circle cx="96" cy="60" r="3" fill="#fff" />
		</g>
		@if (status is not null)
		{
			<circle cx="106" cy="22" r="5" fill="@StatusColor(status)" stroke="#fff" stroke-width="2" />
		}
	</svg>;
}
