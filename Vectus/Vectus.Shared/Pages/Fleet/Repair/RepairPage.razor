@using VectusLibrary.Accounts.Masters.Models
@using VectusLibrary.Fleet.Garage.Models
@using VectusLibrary.Fleet.Repair.Models
@using VectusLibrary.Fleet.Vehicle.Models

@attribute [Route(PageRouteNames.Repair)]
@attribute [Route(PageRouteNames.Repair + "/{Id:int}")]

<PageTitle>Repair - Vectus</PageTitle>

<MudBlazor.MudHotkey Key=JsKey.KeyN KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ResetPage" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyF KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => _sfFirstFocus.FocusAsync()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyG KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => _sfJobFocus.FocusAsync()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.Enter KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="AddJobToCart" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyS KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => SaveTransaction()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyP KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => SaveTransaction(savePDF: true)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyE KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => SaveTransaction(saveExcel: true)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyP KeyModifiers=[JsKeyModifier.AltLeft] OnHotkeyPressed="ExportPdfInvoice" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyE KeyModifiers=[JsKeyModifier.AltLeft] OnHotkeyPressed="ExportExcelInvoice" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyH KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => AuthenticationService.NavigateToRoute(PageRouteNames.RepairReport, FormFactor, JSRuntime, NavigationManager)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.Insert OnHotkeyPressed="() => EditSelectedCartItem()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.Delete OnHotkeyPressed="() => RemoveSelectedCartItem()" Disabled="@_isProcessing" />

@if (_isLoading || _user is null)
{
	<LoadingScreen />
}
else
{
	<div class="page-shell">
		<Header Title="@(_repair.Id > 0 ? $"Edit Repair {_repair.TransactionNo}" : "Create Repair")">
			<LeftContent>
				<SfMenu TValue="Syncfusion.Blazor.Navigations.MenuItem">
					<MenuAnimationSettings Effect="Syncfusion.Blazor.Navigations.MenuEffect.SlideDown" Duration="300" Easing="ease" />
					<MenuEvents TValue="Syncfusion.Blazor.Navigations.MenuItem" ItemSelected="OnMenuSelected" OnOpen='async () => await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0)' />
					<MenuItems>
						<MenuItem Text="File" IconCss="e-icons e-folder">
							<MenuItems>
								<MenuItem Text="New Transaction (Ctrl + N)" IconCss="e-icons e-plus" Id="NewTransaction" Disabled="@_isProcessing" />
								<MenuItem Separator="true" />
								<MenuItem Text="Save (Ctrl + S)" IconCss="e-icons e-save" Id="SaveTransaction" Disabled="@_isProcessing" />
								<MenuItem Text="Save & PDF (Ctrl + P)" IconCss="e-icons e-export-pdf" Id="SavePdfInvoice" Disabled="@_isProcessing" />
								<MenuItem Text="Save & Excel (Ctrl + E)" IconCss="e-icons e-export-excel" Id="SaveExcelInvoice" Disabled="@_isProcessing" />
								<MenuItem Separator="true" />
								<MenuItem Text="Export PDF (Alt + P)" IconCss="e-icons e-export-pdf" Id="ExportPdfInvoice" Disabled="@(_isProcessing || !Id.HasValue || Id.Value <= 0)" />
								<MenuItem Text="Export Excel (Alt + E)" IconCss="e-icons e-export-excel" Id="ExportExcelInvoice" Disabled="@(_isProcessing || !Id.HasValue || Id.Value <= 0)" />
							</MenuItems>
						</MenuItem>
						<MenuItem Text="Open" IconCss="e-icons e-folder-open">
							<MenuItems>
								<MenuItem Text="Repair Report (Ctrl + H)" Id="RepairReport" Disabled="@_isProcessing" />
								<MenuItem Text="Repair Job Report" Id="RepairJobReport" Disabled="@_isProcessing" />
							</MenuItems>
						</MenuItem>
					</MenuItems>
				</SfMenu>
			</LeftContent>
		</Header>

		<!-- Main Content Container -->
		<div class="page-container">

			<!-- Top Section: Transaction Summary -->
			<div class="two-column-layout">
				<!-- Transaction Summary Section -->
				<div class="section-card">
					<div class="section-header">
						<div class="section-title-wrapper">
							<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
								<polyline points="14 2 14 8 20 8" />
								<line x1="16" y1="13" x2="8" y2="13" />
								<line x1="16" y1="17" x2="8" y2="17" />
								<polyline points="10 9 9 9 8 9" />
							</svg>
							<h2 class="section-title">Transaction Summary</h2>
						</div>
					</div>
					<div class="section-body">
						<div class="form-grid">
							<!-- Company -->
							<div class="form-field">
								<CustomAutoComplete @ref="_sfFirstFocus" T="CompanyModel"
													Value="_selectedCompany"
													DataSource="@_companies"
													Placeholder="Select Company"
													Label="Company (Ctrl + F)"
													ValueChanged="OnCompanyChanged"
													FieldValue="@nameof(CompanyModel.Name)"
													AddNewRoute="@PageRouteNames.CompanyMaster" />
							</div>

							<!-- Vehicle -->
							<div class="form-field">
								<CustomAutoComplete T="VehicleLocationModel"
													Value="_selectedVehicle"
													DataSource="@_vehicles"
													Placeholder="Select Vehicle"
													Label="Vehicle"
													ValueChanged="OnVehicleChanged"
													FieldValue="@nameof(VehicleLocationModel.Code)"
													AddNewRoute="@PageRouteNames.VehicleMaster" />
							</div>

							<!-- Garage -->
							<div class="form-field">
								<CustomAutoComplete T="GarageModel"
													Value="_selectedGarage"
													DataSource="@_garages"
													Placeholder="Select Garage"
													Label="Garage"
													ValueChanged="OnGarageChanged"
													FieldValue="@nameof(GarageModel.Name)"
													AddNewRoute="@PageRouteNames.GarageMaster" />
							</div>

							<!-- Transaction Date -->
							<div class="form-field">
								<CustomDatePicker @bind-Value="_repair.TransactionDateTime"
												  FinancialYear="@_selectedFinancialYear" />
							</div>

							<!-- Transaction No -->
							<div class="form-field">
								<CustomTextField @bind-Value="_repair.TransactionNo"
												 Label="Transaction No"
												 Placeholder="Enter Transaction No"
												 ReadOnly="true"
												 TabIndex="-1" />
							</div>

							<!-- Current KM -->
							<div class="form-field">
								<CustomNumericField T="decimal?"
													@bind-Value="_repair.CurrentKM"
													Min="0"
													Label="Current KM"
													Placeholder="0.00"
													Required="false" />
							</div>

							<!-- Garage In -->
							<div class="form-field">
								<CustomDatePicker Value="_repair.GarageInDateTime"
												  ValueChanged="OnGarageInDateChanged"
												  Label="Garage In Date"
												  ShowFinancialYear="false" />
							</div>

							<!-- Garage Out -->
							<div class="form-field">
								<CustomDatePicker Value="_garageOutDate"
												  ValueChanged="OnGarageOutDateChanged"
												  Label="Garage Out Date"
												  Required="false"
												  ShowFinancialYear="false" />
							</div>

							<!-- Remarks -->
							<div class="form-field">
								<CustomTextField @bind-Value="_repair.Remarks"
												 Label="Remarks / Narration"
												 Placeholder="Enter remarks..."
												 Required="false"
												 Lines="2" />
							</div>
						</div>
					</div>
				</div>

				<!-- Financial Summary Section -->
				<div class="section-card">
					<div class="section-header">
						<div class="section-title-wrapper">
							<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="12" y1="1" x2="12" y2="23" />
								<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
							</svg>
							<h2 class="section-title">Financial Summary</h2>
						</div>
					</div>
					<div class="section-body">
						<div class="form-grid">
							<!-- Total Items -->
							<div class="form-field">
								<CustomNumericField T="int"
													Value="_repair.TotalItems"
													Placeholder="0"
													Label="Total Items"
													ReadOnly="true"
													Required="false"
													TabIndex="-1" />
							</div>

							<!-- Total Quantity -->
							<div class="form-field">
								<CustomNumericField T="decimal"
													Value="_repair.TotalQuantity"
													Placeholder="0.00"
													Label="Total Quantity"
													ReadOnly="true"
													Required="false"
													TabIndex="-1" />
							</div>

							<hr class="form-divider" />

							<!-- Total Amount -->
							<div class="form-field">
								<CustomNumericField T="decimal"
													Value="_repair.TotalAmount"
													Placeholder="0.00"
													Label="Total Amount"
													ReadOnly="true"
													Required="false"
													TabIndex="-1" />
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Add to Cart Section -->
			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
							 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
							 stroke-linejoin="round">
							<circle cx="9" cy="21" r="1" />
							<circle cx="20" cy="21" r="1" />
							<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
						</svg>
						<h2 class="section-title">Add Repair Job</h2>
					</div>
				</div>
				<div class="section-body">
					<!-- Single Row: All Components -->
					<div class="cart-input-row">
						<div class="cart-field cart-field-wide">
							<CustomTextField @ref="_sfJobFocus"
											 @bind-Value="_selectedCart.Job"
											 Label="Job (Ctrl + G)"
											 Placeholder="Enter job description..." />
						</div>

						<div class="cart-field">
							<CustomNumericField T="decimal"
												Value="_selectedCart.Quantity"
												ValueChanged="OnCartQuantityChanged"
												Min="0"
												Label="Quantity"
												Placeholder="0.00" />
						</div>

						<div class="cart-field">
							<CustomNumericField T="decimal"
												Value="_selectedCart.Rate"
												ValueChanged="OnCartRateChanged"
												Min="0"
												Label="Rate"
												Placeholder="0.00" />
						</div>

						<div class="cart-field">
							<CustomNumericField T="decimal"
												Value="_selectedCart.Total"
												Placeholder="0.00"
												Label="Total"
												ReadOnly="true"
												Required="false"
												TabIndex="-1" />
						</div>

						<div class="cart-field cart-field-wide">
							<CustomTextField @bind-Value="_selectedCart.Remarks"
											 Label="Remarks"
											 Placeholder="Job narration..."
											 Required="false" />
						</div>

						<div class="cart-field">
							<IconButton Icon="IconType.Add" Variant="ButtonVariant.Add" Text="Add" Title="Add to Cart"
										OnClick="AddJobToCart" />
						</div>
					</div>
				</div>
			</div>

			<!-- Cart Items Grid Section -->
			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3 3h7a3 3 0 0 1 3 3v14a3 3 0 0 1-3 3H3V3z" />
							<path d="M14 3h7v17h-7V3z" />
						</svg>
						<h2 class="section-title">Repair Jobs</h2>
					</div>
				</div>
				<div class="section-body grid-body">
					<SfGrid @ref="_sfCartGrid" DataSource="_cart" AllowTextWrap="true" AllowPaging="false"
							AllowSorting="true" AllowResizing="true" AllowFiltering="true" GridLines="GridLine.Horizontal"
							CssClass="professional-grid" ContextMenuItems="@_cartGridContextMenuItems"
							Toolbar="@(new List<string>() { "Search" })">

						<GridEvents TValue="RepairJobCartModel" ContextMenuItemClicked="OnCartGridContextMenuItemClicked" />

						<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

						<GridAggregates>
							<GridAggregate>
								<GridAggregateColumns>
									<GridAggregateColumn Field="Job" Type="AggregateType.Count">
										<FooterTemplate>
											@{
												var aggregate = (context as AggregateTemplateContext);
											}
											<div class="aggregate-label">
												<strong>Total Jobs: @aggregate.Count</strong>
											</div>
										</FooterTemplate>
									</GridAggregateColumn>
									<GridAggregateColumn Field="Quantity" Type="AggregateType.Sum">
										<FooterTemplate>
											@{
												var aggregate = (context as AggregateTemplateContext);
												var sum = aggregate.Sum != null ? Convert.ToDecimal(aggregate.Sum) : 0m;
											}
											<div class="aggregate-value">
												<strong>@sum.ToString("N2")</strong>
											</div>
										</FooterTemplate>
									</GridAggregateColumn>
									<GridAggregateColumn Field="Total" Type="AggregateType.Sum">
										<FooterTemplate>
											@{
												var aggregate = (context as AggregateTemplateContext);
												var sum = aggregate.Sum != null ? Convert.ToDecimal(aggregate.Sum) : 0m;
											}
											<div class="aggregate-value aggregate-total">
												<strong>@sum.ToString("N2")</strong>
											</div>
										</FooterTemplate>
									</GridAggregateColumn>
								</GridAggregateColumns>
							</GridAggregate>
						</GridAggregates>

						<GridColumns>
							<GridColumn Field="Job" HeaderText="Job" Width="300" />
							<GridColumn Field="Quantity" HeaderText="Quantity" Width="130" TextAlign="TextAlign.Right" Format="N2" />
							<GridColumn Field="Rate" HeaderText="Rate" Width="130" TextAlign="TextAlign.Right" Format="N2" />
							<GridColumn Field="Total" HeaderText="Total" Width="150" TextAlign="TextAlign.Right" Format="N2">
								<Template>
									@{
										var item = (context as RepairJobCartModel);
										<span class="grid-total">@item.Total.ToString("N2")</span>
									}
								</Template>
							</GridColumn>
							<GridColumn Field="Remarks" HeaderText="Remarks" Width="400" />
						</GridColumns>
					</SfGrid>
				</div>
			</div>
		</div>

		<Footer />
	</div>
}

<ToastNotification @ref="_toastNotification" />

<NavigationLock ConfirmExternalNavigation="@_isProcessing" />
