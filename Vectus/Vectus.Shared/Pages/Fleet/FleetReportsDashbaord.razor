@attribute [Route(PageRouteNames.FleetReportsDashboard)]

<PageTitle>Fleet Reports - Vectus</PageTitle>

<MudBlazor.MudHotkey Key=JsKey.KeyB KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => NavigationManager.NavigateTo(PageRouteNames.Dashboard)" />

@if (_isLoading || _user is null)
{
	<LoadingScreen />
}
else
{
	<div class="page-shell">
		<Header Title="Fleet Reports" />

		<div class="page-container">

			<!-- TRIPS -->
			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="1" y="3" width="15" height="13" />
							<polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
							<circle cx="5.5" cy="18.5" r="2.5" />
							<circle cx="18.5" cy="18.5" r="2.5" />
						</svg>
						<h2 class="section-title">Trips</h2>
					</div>
					<p class="section-subtitle">Filter and export trip request transactions across the fleet</p>
				</div>
				<div class="section-body">
					<div class="dashboard-grid">

						<FileCard Title="Trip Request Report" Description="View, filter and export all trip requests by company, vehicle, route and SDR" OnClick="() => NavigationManager.NavigateTo(PageRouteNames.TripRequestReport)">
							<IconContent>
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
									<polyline points="14 2 14 8 20 8" />
									<line x1="16" y1="13" x2="8" y2="13" />
									<line x1="16" y1="17" x2="8" y2="17" />
									<polyline points="10 9 9 9 8 9" />
								</svg>
							</IconContent>
						</FileCard>

					</div>
				</div>
			</div>

			<!-- REPAIRS -->
			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
						</svg>
						<h2 class="section-title">Repairs</h2>
					</div>
					<p class="section-subtitle">Filter and export vehicle repair transactions and job details</p>
				</div>
				<div class="section-body">
					<div class="dashboard-grid">

						<FileCard Title="Repair Report" Description="View, filter and export all repair transactions by company, vehicle and garage" OnClick="() => NavigationManager.NavigateTo(PageRouteNames.RepairReport)">
							<IconContent>
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
									<polyline points="14 2 14 8 20 8" />
									<line x1="16" y1="13" x2="8" y2="13" />
									<line x1="16" y1="17" x2="8" y2="17" />
									<polyline points="10 9 9 9 8 9" />
								</svg>
							</IconContent>
						</FileCard>

						<FileCard Title="Repair Job Report" Description="View, filter and export individual repair jobs across all transactions" OnClick="() => NavigationManager.NavigateTo(PageRouteNames.RepairJobReport)">
							<IconContent>
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 3h7a3 3 0 0 1 3 3v14a3 3 0 0 1-3 3H3V3z" />
									<path d="M14 3h7v17h-7V3z" />
								</svg>
							</IconContent>
						</FileCard>

					</div>
				</div>
			</div>

		</div>

		<Footer />
	</div>
}
