@attribute [Route(PageRouteNames.FleetTransactionsDashboard)]

<PageTitle>Fleet Transactions - Vectus</PageTitle>

<MudBlazor.MudHotkey Key=JsKey.KeyB KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => NavigationManager.NavigateTo(PageRouteNames.Dashboard)" />

@if (_isLoading || _user is null)
{
	<LoadingScreen />
}
else
{
	<div class="page-shell">
		<Header Title="Fleet Transactions" />

		<div class="page-container">

			<!-- TRIPS -->
			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="1" y="3" width="15" height="13" />
							<polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
							<circle cx="5.5" cy="18.5" r="2.5" />
							<circle cx="18.5" cy="18.5" r="2.5" />
						</svg>
						<h2 class="section-title">Trips</h2>
					</div>
					<p class="section-subtitle">Raise and track trip requests for routes and vehicles</p>
				</div>
				<div class="section-body">
					<div class="dashboard-grid">

						<FileCard Title="Trip Request" Description="Raise a trip request against a route and vehicle for approval" OnClick="() => NavigationManager.NavigateTo(PageRouteNames.TripRequest)">
							<IconContent>
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M9 2h6a1 1 0 0 1 1 1v2H8V3a1 1 0 0 1 1-1z" />
									<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
									<path d="M9 13l2 2 4-4" />
								</svg>
							</IconContent>
						</FileCard>

					</div>
				</div>
			</div>

			<!-- REPAIRS -->
			<div class="section-card">
				<div class="section-header">
					<div class="section-title-wrapper">
						<svg class="section-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
						</svg>
						<h2 class="section-title">Repairs</h2>
					</div>
					<p class="section-subtitle">Record vehicle repair jobs carried out at garages</p>
				</div>
				<div class="section-body">
					<div class="dashboard-grid">

						<FileCard Title="Repair" Description="Create a repair transaction with jobs for a vehicle at a garage" OnClick="() => NavigationManager.NavigateTo(PageRouteNames.Repair)">
							<IconContent>
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
								</svg>
							</IconContent>
						</FileCard>

					</div>
				</div>
			</div>

		</div>

		<Footer />
	</div>
}
